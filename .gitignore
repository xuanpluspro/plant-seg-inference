__pycache__/
*.py[cod]
.venv/
*.pth
*.pt
*.onnx
*.tmp
data/*
!data/README.md
weights/*
!weights/README.md
outputs/
*visual/
!weights/color/
weights/color/**
!weights/color/README.md
!weights/color/xgboost/
!weights/color/xgboost/README.md
!weights/color/svm/
!weights/color/svm/README.md
