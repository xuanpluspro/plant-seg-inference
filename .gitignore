# Explicitly tracked source color models/reports; other user weights stay ignored.
!weights/color/xgboost/training_report.json
!weights/color/xgboost/models_manifest.json
!weights/color/xgboost/result1/
!weights/color/xgboost/result1/training_report*.json
!weights/color/xgboost/result2/
!weights/color/xgboost/result2/training_report*.json
!weights/color/xgboost/result3/
!weights/color/xgboost/result3/training_report*.json

# Color model binaries are supplied locally.
weights/color/**/*.pkl
weights/color/**/*.pickle
weights/color/**/*.joblib
